# NTK Production Backend Portable Configuration (.env.example)
# Copy this file to config/ntk_backend.env and adjust paths for your laptop Linux/WSL2 environment.

# 1. Server HTTP binding & CORS
NTK_BACKEND_HOST=127.0.0.1
NTK_BACKEND_PORT=8765
NTK_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 2. Model & EO06 LoRA Adapter paths (from NTK_PRIVATE_REPRO_20261028.tar.gz)
# Base model: HuggingFace Qwen/Qwen2.5-Coder-0.5B-Instruct (snapshot ea3f2471cf1b1f0db85067f1ef93848e38e88c25)
NTK_BASE_MODEL_PATH=/path/to/models--Qwen--Qwen2.5-Coder-0.5B-Instruct/snapshots/ea3f2471cf1b1f0db85067f1ef93848e38e88c25
# Selected EO06 LoRA adapter (Epoch 3 best_checkpoint, SHA-256: 176b9b32ada029ba38a561b0937ccb75cb18c720979dbb58824fdcc112d2ce84)
NTK_BEST_ADAPTER_PATH=/path/to/ntk_private_repro/models/eo06_vnext31_trackb_main/best_checkpoint
# Device: auto | cuda | cpu
NTK_INFERENCE_DEVICE=auto

# 3. Verified EO06 VNext.3.1 Dataset directory (from NTK_PRIVATE_REPRO_20261028.tar.gz)
NTK_DATASET_DIR=/path/to/ntk_private_repro/dataset_vnext_3_1

# 4. Persisted Scan Store & Native Linux ext4 Cache directory
# IMPORTANT FOR WSL2: Keep NTK_EXT4_CACHE_DIR on native Linux ext4 (e.g. $HOME/.cache/ntk_iris_scan_cache_v1)
# to avoid slow Windows /mnt/c 9p filesystem overhead during git clone and SQLite cache operations.
NTK_STORAGE_DIR=/path/to/persisted_api_store
NTK_EXT4_CACHE_DIR=/home/$USER/.cache/ntk_iris_scan_cache_v1

# 5. External Tool Binaries
NTK_OPENGREP_BIN=/usr/local/bin/opengrep
NTK_JAVAC_BIN=/usr/bin/javac
NTK_GIT_BIN=/usr/bin/git

# 6. Resource & Safety Guardrails
NTK_MAX_ZIP_UPLOAD_BYTES=52428800
NTK_MAX_ZIP_ENTRIES=2500
NTK_MAX_REPO_BYTES=157286400
NTK_MAX_REPO_BYTES_CEILING=314572800
NTK_MAX_SOURCE_FILES=600
NTK_MAX_SOURCE_FILES_CEILING=3500
NTK_MAX_FILE_BYTES=1048576
NTK_SUBPROCESS_TIMEOUT_SEC=180
NTK_GIT_CLONE_TIMEOUT_SEC=120
NTK_LLM_TIMEOUT_SEC=120
